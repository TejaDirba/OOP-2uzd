CXX       := g++
CXXFLAGS  := -std=c++17 -O2 -Wall -Wextra
SRC_DIR   := src
SRCS      := $(wildcard $(SRC_DIR)/*.cpp)
OBJS      := $(SRCS:.cpp=.o)
TARGET    := app

TEST_DIR    := tests
TEST_SRCS   := $(wildcard $(TEST_DIR)/*.cpp)
TEST_OBJS   := $(TEST_SRCS:.cpp=.o)
TEST_TARGET := StudentTests

DOC_DIR  := docs

.PHONY: all build test docs clean

all: build

build: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) -o $@ $^

$(TEST_TARGET): $(OBJS) $(TEST_OBJS)
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) -I$(TEST_DIR) -lgtest -lpthread -o $@ $^

test: $(TEST_TARGET)
	@echo "→ Running GoogleTest suite..."
	./$(TEST_TARGET)

docs:
	cd $(DOC_DIR) && doxygen Doxyfile

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) -c $< -o $@

clean:
	rm -f $(OBJS) $(TEST_OBJS) $(TARGET) $(TEST_TARGET)
