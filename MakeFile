CXX := g++
CXXFLAGS := -std=c++17 -O2 -Wall -Wextra
SRCS := main.cpp FileManager.cpp Student.cpp
OBJS := $(SRCS:.cpp=.o)
TARGET := app

TEST_SRCS := StudentTest.cpp
TEST_OBJS := $(TEST_SRCS:.cpp=.o)
TEST_TARGET := test_student

.PHONY: all test clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

$(TEST_TARGET): $(OBJS) $(TEST_OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $<

test: $(TEST_TARGET)
	@echo "Running Student unit tests..."
	./$(TEST_TARGET)

clean:
	rm -f $(OBJS) $(TEST_OBJS) $(TARGET) $(TEST_TARGET)
